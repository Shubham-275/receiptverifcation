# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="Receipt Intelligence API"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ───────────────────────────────────────────────────────────────────
# Async DSN used by the application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/receiptdb

# Sync DSN used only by Alembic migrations (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/receiptdb

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── AI Provider & Models ───────────────────────────────────────────────────────
LLM_PROVIDER=auto                     # 'auto' (detects OpenRouter or Gemini), or force 'openrouter' / 'gemini'

# ── OpenRouter (google/gemma-3-12b-it) ─────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-3-12b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Google Gemini (optional fallback) ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Receipt classifier ─────────────────────────────────────────────────────────
RECEIPT_CONFIDENCE_THRESHOLD=0.75

# ── Product resolution ─────────────────────────────────────────────────────────
FUZZY_MATCH_THRESHOLD=85
ALIAS_AUTO_ACCEPT_CONFIDENCE=0.90

# ── File upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760   # 10 MB

# ── Discord (Phase 12 — leave blank until needed) ─────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_RECEIPT_CHANNEL_ID=0
DISCORD_QUERY_CHANNEL_ID=0
